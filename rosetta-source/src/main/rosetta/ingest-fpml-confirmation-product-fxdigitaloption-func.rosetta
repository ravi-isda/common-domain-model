namespace cdm.ingest.fpml.confirmation.product.fxdigitaloption
version "${project.version}"

import cdm.base.staticdata.party.*
import cdm.ingest.fpml.confirmation.common.*
import cdm.ingest.fpml.confirmation.party.*
import cdm.ingest.fpml.confirmation.pricequantity.*
import cdm.ingest.fpml.confirmation.settlement.*
import cdm.observable.asset.*
import cdm.observable.event.*
import cdm.product.template.*

import fpml.consolidated.* as fpml
import fpml.consolidated.fpmlenum.* as fpml
import fpml.consolidated.fx.* as fpml

func MapFxDigitalOptionNonTransferableProduct:
    inputs:
        fpmlFxDigitalOption fpml.FxDigitalOption (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        nonTransferableProduct NonTransferableProduct (0..1)

    set nonTransferableProduct:
        NonTransferableProduct {
            identifier: MapProductIdentifierList(fpmlFxDigitalOption -> productId),
            taxonomy: MapProductTaxonomyList(
                        fpmlFxDigitalOption -> primaryAssetClass,
                        fpmlFxDigitalOption -> secondaryAssetClass,
                        fpmlFxDigitalOption -> productType
                    ),
            economicTerms: MapFxDigitalOptionEconomicTerms(
                        fpmlFxDigitalOption,
                        cdmCounterpartyList
                    )
        }

func MapFxDigitalOptionCounterpartyList:
    inputs:
        fpmlFxDigitalOption fpml.FxDigitalOption (0..1)
    output:
        counterpartyList Counterparty (0..2)

    add counterpartyList:
        MapBuyerSellerModelToCounterpartyList(
                fpmlFxDigitalOption -> buyerPartyReference,
                fpmlFxDigitalOption -> sellerPartyReference
            )

func MapFxDigitalOptionAncillaryPartyList:
    inputs:
        fpmlFxDigitalOption fpml.FxDigitalOption (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        ancillaryPartyList AncillaryParty (0..*)

    add ancillaryPartyList:
        MapExerciseProcedureToAncillaryParty(
                fpmlFxDigitalOption -> exerciseProcedure,
                cdmCounterpartyList
            )

func MapFxDigitalOptionEconomicTerms:
    inputs:
        fpmlFxDigitalOption fpml.FxDigitalOption (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        economicTerms EconomicTerms (0..1)

    set economicTerms:
        EconomicTerms {
            payout: MapFxDigitalOptionPayout(fpmlFxDigitalOption, cdmCounterpartyList),
            ...
        }

func MapFxDigitalOptionPayout:
    inputs:
        fpmlFxDigitalOption fpml.FxDigitalOption (0..1)
        cdmCounterpartyList Counterparty (0..2)
    output:
        payout Payout (0..1)

    set payout:
        Payout {
            OptionPayout:
                OptionPayout {
                    payerReceiver: MapSellerAsPayerAndBuyerAsReceiver(
                                fpmlFxDigitalOption -> sellerPartyReference,
                                fpmlFxDigitalOption -> buyerPartyReference,
                                cdmCounterpartyList
                            ),
                    settlementTerms: MapFxDigitalOptionToSettlementTerms(
                                fpmlFxDigitalOption
                            ),
                    buyerSeller: MapBuyerSeller(
                                fpmlFxDigitalOption -> buyerPartyReference,
                                fpmlFxDigitalOption -> sellerPartyReference,
                                cdmCounterpartyList
                            ),
                    underlier:
                        Underlier {
                            Observable:
                                Observable {
                                    Asset: MapCurrencyToAssetCash(fpmlFxDigitalOption -> payout -> currency),
                                    ...
                                },
                            ...
                        },
                    exerciseTerms: MapExerciseTerms(
                                GetFpmlFxDigitalExercise(fpmlFxDigitalOption),
                                fpmlFxDigitalOption -> exerciseProcedure,
                                empty,
                                fpmlFxDigitalOption -> buyerPartyReference,
                                fpmlFxDigitalOption -> sellerPartyReference,
                                cdmCounterpartyList
                            ),
                    feature:
                        OptionFeature {
                            digitalOption:
                                DigitalOption {
                                    isApplicable: True,
                                    trigger:
                                        if fpmlFxDigitalOption -> trigger exists
                                        then fpmlFxDigitalOption -> trigger
                                            extract MapFxTriggerToDigitalTrigger(item)
                                        else if fpmlFxDigitalOption -> touch exists
                                        then fpmlFxDigitalOption -> touch
                                            extract MapFxTouchToDigitalTrigger(item)
                                },
                            ...
                        },
                    ...
                },
            ...
        }

func MapFxTriggerToDigitalTrigger: <"Maps an FpML FxTrigger (European-style digital trigger, evaluated at expiry) to a CDM DigitalTrigger with triggerTimeType = Closing.">
    inputs:
        fpmlFxTrigger fpml.FxTrigger (0..1)
    output:
        digitalTrigger DigitalTrigger (0..1)

    set digitalTrigger:
        DigitalTrigger {
            level:
                PriceSchedule {
                    value: fpmlFxTrigger -> triggerRate,
                    priceType: PriceTypeEnum -> ExchangeRate,
                    ...
                },
            triggerType: MapTriggerConditionToTriggerType(fpmlFxTrigger -> triggerCondition),
            triggerTimeType: TriggerTimeTypeEnum -> Closing,
            ...
        }

func MapFxTouchToDigitalTrigger: <"Maps an FpML FxTouch (American-style digital trigger, continuously monitored) to a CDM DigitalTrigger with triggerTimeType = Anytime and populated touchCondition.">
    inputs:
        fpmlFxTouch fpml.FxTouch (0..1)
    output:
        digitalTrigger DigitalTrigger (0..1)

    set digitalTrigger:
        DigitalTrigger {
            level:
                PriceSchedule {
                    value: fpmlFxTouch -> triggerRate,
                    priceType: PriceTypeEnum -> ExchangeRate,
                    ...
                },
            triggerType: MapTriggerConditionToTriggerType(fpmlFxTouch -> direction),
            triggerTimeType: TriggerTimeTypeEnum -> Anytime,
            touchCondition: MapTouchCondition(fpmlFxTouch -> touchCondition),
            ...
        }

func MapTriggerConditionToTriggerType: <"Maps FpML TriggerConditionEnum (AtOrAbove / AtOrBelow) to CDM TriggerTypeEnum (EqualOrGreater / EqualOrLess).">
    inputs:
        fpmlTriggerCondition fpml.TriggerConditionEnum (0..1)
    output:
        triggerType TriggerTypeEnum (0..1)

    set triggerType:
        if fpmlTriggerCondition = fpml.TriggerConditionEnum -> AtOrAbove
        then TriggerTypeEnum -> EqualOrGreater
        else if fpmlTriggerCondition = fpml.TriggerConditionEnum -> AtOrBelow
        then TriggerTypeEnum -> EqualOrLess

func MapTouchCondition: <"Maps FpML TouchConditionEnum (Touch / Notouch) to CDM TouchConditionEnum (Touch / NoTouch).">
    inputs:
        fpmlTouchCondition fpml.TouchConditionEnum (0..1)
    output:
        touchCondition TouchConditionEnum (0..1)

    set touchCondition:
        if fpmlTouchCondition = fpml.TouchConditionEnum -> Touch
        then TouchConditionEnum -> Touch
        else if fpmlTouchCondition = fpml.TouchConditionEnum -> Notouch
        then TouchConditionEnum -> NoTouch
